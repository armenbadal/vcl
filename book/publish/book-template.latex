\definecolor{colourblue}{RGB}{0,82,155}

\titleformat{\chapter}[display]
  {\normalfont\bfseries\color{colourblue}}
  {\filleft%
    \begin{tikzpicture}
    \node[
      outer sep=0pt,
      text width=2.5cm,
      minimum height=3cm,
      fill=colourblue,
      font=\color{white}\sffamily\fontsize{64}{64}\selectfont,
      align=center
      ] (num) {\thechapter};
    \end{tikzpicture}%
  }
  {10pt}
  {\titlerule[2.5pt]\vskip3pt\titlerule\vskip4pt\LARGE\color{black}\MakeUppercase}

\captionsetup{font=small,skip=20pt}

